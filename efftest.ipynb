import io
import cobra

model_base = cobra.io.load_model("iMM904")

model_base.reactions.EX_glc__D_e.lower_bound = 0  
model_base.reactions.EX_o2_e.lower_bound = 0 # fermentation
model_base.reactions.EX_xyl__D_e.lower_bound = -10
model_base.reactions.XYLR.lower_bound = 0
model_base.reactions.XYLR.upper_bound = 0 #this reaction shouldnt be in this model, lol

model_wt = model_base.copy()
wt_sol = model_wt.optimize()  
print(f"wild type growth speed {wt_sol.objective_value:.4f}")
print(f"wild type ethanol prod {model_wt.reactions.EX_etoh_e.flux:.4f}")

model_mutant = model_base.copy()
xi_react = cobra.Reaction("XYLOSE_ISOMERASE")
xi_react.name = "Heterologous Xylose Isomerase from Piromyces"
xi_react.lower_bound = 0 # say, irreversible
xi_react.upper_bound = 1000

xi_react.add_metabolites({
    model_mutant.metabolites.xyl__D_c: -1,
    model_mutant.metabolites.xylu__D_c: 1
})

model_mutant.add_reactions([xi_react])

mutant_sol = model_mutant.optimize()
print(f"mod strain growth speed {mutant_sol.objective_value:.4f}")
print(f"mod strain ethanol prod {model_mutant.reactions.EX_etoh_e.flux:.4f}")
